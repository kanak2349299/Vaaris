# Vaaris Backend Environment Configuration
PROJECT_NAME="Vaaris - Digital Legacy Management"

# Database Configuration (sqlite or supabase)
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./vaaris.db

# For Supabase PostgreSQL, uncomment and set:
# DATABASE_TYPE=supabase
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
# SUPABASE_KEY=[ANON-OR-SERVICE-KEY]

# Security
JWT_SECRET=vaaris_super_secret_hackathon_jwt_key_2026

# Twilio WhatsApp Integration (Optional - Realistic mock active by default)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886

# Frontend Client URL
APP_URL=http://localhost:5173
